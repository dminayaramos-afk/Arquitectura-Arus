    # =============================
    # ESTADO DE ARUS
    # =============================

    def set_arus_state(self, state):

        self.core.set_state(
            state
        )


        self.lbl_state.setText(
            "Estado: "
            + state.upper()
        )



    # =============================
    # PROCESAR CHAT
    # =============================

    def process_chat(self, text):

        try:

            self.set_arus_state(
                "thinking"
            )


            response = self.controller.process(
                text
            )


            self.set_arus_state(
                "idle"
            )


            return response


        except Exception as e:


            self.set_arus_state(
                "idle"
            )


            return (
                "Error ARUS: "
                + str(e)
            )



    # =============================
    # MENSAJE DEL SISTEMA
    # =============================

    def system_message(self, text):

        self.chat.add_message(
            "ARUS: " + text
        )



    # =============================
    # LIMPIAR ESTADO
    # =============================

    def reset_state(self):

        self.core.set_state(
            "idle"
        )


        self.lbl_state.setText(
            "Estado: IDLE"
        )
    # =============================
    # CIERRE DE ARUS
    # =============================

    def closeEvent(self, event):

        try:

            if hasattr(
                self,
                "voice"
            ):

                if hasattr(
                    self.voice,
                    "stop"
                ):

                    self.voice.stop()


        except Exception:

            pass


        self.core.set_state(
            "idle"
        )


        event.accept()



    # =============================
    # ACTIVAR VENTANA
    # =============================

    def showEvent(self, event):

        self.chat.input.setFocus()

        self.core.set_state(
            "idle"
        )

        super().showEvent(
            event
        )
