        self.mode_state.setText(
            f"Modo: {self.interface_mode}"
        )
    # =============================
    # TECLADO GLOBAL
    # =============================

    def keyPressEvent(self, event):

        key = event.key()
        text = event.text()

        # ENTER -> enviar mensaje

        if key in (
            Qt.Key_Return,
            Qt.Key_Enter
        ):

            self.chat.send()

            return

        # ESC -> limpiar

        if key == Qt.Key_Escape:

            self.chat.input.clear()

            return

        # Si es un carácter normal,
        # activar automáticamente el chat

        if text and text.isprintable():

            self.chat.input.setFocus()

            self.chat.input.insert(
                text
            )

            self.core.set_state(
                "listening"
            )

            self.lbl_state.setText(
                "Estado: ESCRIBIENDO"
            )

            return

        super().keyPressEvent(
            event
        )


    # =============================
    # CUANDO EL CHAT CAMBIA
    # =============================

    def chat_active(self):

        self.core.set_state(
            "listening"
        )

        self.lbl_state.setText(
            "Estado: ESCUCHANDO"
        )


    def chat_idle(self):

        self.core.set_state(
            "idle"
        )

        self.lbl_state.setText(
            "Estado: IDLE"
        )

    # =============================
    # BOTÓN VOZ
    # =============================

    def toggle_voice(self):

        try:

            if hasattr(
                self.voice,
                "start"
            ):

                self.voice.start()


            self.voice_state.setText(
                "🎤 Voz: Activa"
            )


            self.core.set_state(
                "listening"
            )


            self.lbl_state.setText(
                "Estado: ESCUCHANDO"
            )


        except Exception as e:

            self.voice_state.setText(
                "🎤 Voz: No disponible"
            )



    # =============================
    # BOTÓN MEMORIA
    # =============================

    def open_memory(self):

        self.ai_state.setText(
            "🧠 IA: Memoria"
