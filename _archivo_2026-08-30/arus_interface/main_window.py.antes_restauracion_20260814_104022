        )



    # =============================
    # BOTÓN APRENDIZAJE
    # =============================

    def open_learning(self):

        self.ai_state.setText(
            "🧠 IA: Aprendiendo"
        )


        self.core.set_state(
            "learning"
        )


        self.chat.add_message(
            "ARUS: Ciclo de aprendizaje iniciado."
        )



    # =============================
    # BOTÓN CONFIGURACIÓN
    # =============================

    def open_settings(self):

